# ============================================================
#  Configuration de l'agent financier vocal
#  Copie ce fichier en « .env » puis remplis ta cle.
# ============================================================

# Ta cle API Anthropic (OBLIGATOIRE). Commence par « sk-ant-... »
# Tu l'obtiens sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-remplace-moi

# Modele Claude utilise (optionnel). Par defaut: claude-opus-4-8 (le plus intelligent).
# Pour des reponses plus rapides et moins couteuses, tu peux mettre: claude-sonnet-4-6
MODELE=claude-opus-4-8

# Niveau d'effort/reflexion (optionnel): low | medium | high
# « medium » = bon equilibre vitesse/qualite pour une rencontre en direct.
EFFORT=medium

# Modele rapide utilise pour DETECTER les sujets en continu (optionnel).
MODELE_DETECTION=claude-haiku-4-5

# Recherche web pour des chiffres a jour (optionnel): true | false
# Si ton compte n'a pas la recherche web, l'agent bascule automatiquement
# sur les connaissances du modele. Tu peux aussi la desactiver ici.
RECHERCHE_WEB=true

# Port du serveur web local (optionnel)
PORT=3000
