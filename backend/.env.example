# ============================================================
#  Backend — agent financier temps reel
#  Copie ce fichier en « .env » et remplis tes cles.
# ============================================================

# Cle Deepgram (transcription temps reel). https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Cle Anthropic (suggestions temps reel, Phase 2). https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modeles Claude (facultatif - valeurs par defaut deja optimisees)
# DETECTION_MODEL=claude-haiku-4-5
# ORCHESTRATEUR_MODEL=claude-sonnet-4-6

# Modele Deepgram : nova-3 (impose par le cahier de charges) ou nova-2 (eprouve)
DEEPGRAM_MODEL=nova-3
# Langue : fr-CA (francais canadien) ou fr
DEEPGRAM_LANG=fr-CA

# Port du backend
PORT=3001

# --- Mise en ligne (production) ---
# Mot de passe pour proteger l'acces a l'app en ligne.
# Laisse vide en local = acces libre. En production = OBLIGATOIRE.
APP_PASSWORD=
# Secret interne pour signer le jeton de session (n'importe quelle longue chaine).
AUTH_SECRET=

# Origine autorisee pour le frontend en developpement (Vite)
CORS_ORIGIN=http://localhost:5173

# --- Phase 3+ (pas requis pour la Phase 1) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
