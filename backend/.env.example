# ============================================================
#  Backend — agent financier temps reel
#  Copie ce fichier en « .env » et remplis tes cles.
# ============================================================

# Cle Deepgram (transcription temps reel). https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Cle Anthropic (utilisee a partir de la Phase 2). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modele Deepgram : nova-3 (impose par le cahier de charges) ou nova-2 (eprouve)
DEEPGRAM_MODEL=nova-3
# Langue : fr-CA (francais canadien) ou fr
DEEPGRAM_LANG=fr-CA

# Port du backend
PORT=3001

# Origine autorisee pour le frontend en developpement (Vite)
CORS_ORIGIN=http://localhost:5173

# --- Phase 3+ (pas requis pour la Phase 1) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
